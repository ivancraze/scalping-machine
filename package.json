{
  "name": "pulse-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "check": "npm run lint && npm run stylelint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "latest",
    "axios": "^1.20.0",
    "lightweight-charts": "^5.2.1",
    "lightweight-charts-line-tools-circle": "github:difurious/lightweight-charts-line-tools-circle",
    "lightweight-charts-line-tools-core": "github:difurious/lightweight-charts-line-tools-core",
    "lightweight-charts-line-tools-fib-retracement": "github:difurious/lightweight-charts-line-tools-fib-retracement",
    "lightweight-charts-line-tools-freehand": "github:difurious/lightweight-charts-line-tools-freehand",
    "lightweight-charts-line-tools-lines": "github:difurious/lightweight-charts-line-tools-lines",
    "lightweight-charts-line-tools-long-short-position": "github:difurious/lightweight-charts-line-tools-long-short-position",
    "lightweight-charts-line-tools-market-depth": "github:difurious/lightweight-charts-line-tools-market-depth",
    "lightweight-charts-line-tools-parallel-channel": "github:difurious/lightweight-charts-line-tools-parallel-channel",
    "lightweight-charts-line-tools-path": "github:difurious/lightweight-charts-line-tools-path",
    "lightweight-charts-line-tools-price-range": "github:difurious/lightweight-charts-line-tools-price-range",
    "lightweight-charts-line-tools-rectangle": "github:difurious/lightweight-charts-line-tools-rectangle",
    "lightweight-charts-line-tools-text": "github:difurious/lightweight-charts-line-tools-text",
    "lightweight-charts-line-tools-triangle": "github:difurious/lightweight-charts-line-tools-triangle",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript-eslint": "^8.69.0"
  }
}
